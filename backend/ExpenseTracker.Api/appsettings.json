{
  "ConnectionStrings": {
    "Database": "Host=<YOUR_DB_SERVER>;Port=<YOUR_DB_PORT>;Username=<YOUR_DB_USER>;Password=<YOUR_DB_PASSWORD>;Database=expense_tracker;"
  },
  "DataEncryptionOptions": {
    "CurrentKeyVersion": 1,
    "Keys": {
      "1": "<YOUR_ENCRYPTION_KEY_BASE64>"
    }
  },
  "HashingOptions": {
    "EmailHmacKey": "<YOUR_ENCRYPTION_KEY_BASE64>",
    "PasswordWorkFactor": 12
  },
  "SessionLifetimeOptions": {
    "StandardSessionDuration": {
      "Hours": 8
    },
    "ExtendedSessionDuration": {
      "Hours": 168
    },
    "AbsoluteSessionLimit": {
      "Hours": 2160
    },
    "StandardExpiryExtension": {
      "Hours": 1
    },
    "ExtendedExpiryExtension": {
      "Hours": 12
    },
    "ExpiryExtensionTriggerPercent": 5
  },
  "CacheTimeToLiveOptions": {
    "AuthSessionById": {
      "Minutes": 10
    },
    "UserAuthenticationState": {
      "Minutes": 10
    },
    "UserProfileById": {
      "Minutes": 5
    }
  },
  "SuperAdminSeedOptions": {
    "FirstName": "Admin",
    "MiddleName": null,
    "LastName": "Super",
    "UserName": "<YOUR_SUPERADMIN_USERNAME>",
    "Email": "<YOUR_SUPERADMIN_EMAIL>",
    "Password": "<YOUR_SUPERADMIN_PASSWORD>"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200"]
  },
  "RateLimiting": {
    "Default": {
      "QueueLimit": 0,
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "Endpoints": {
      "base.get_info": {
        "QueueLimit": 0,
        "PermitLimit": 200,
        "WindowSeconds": 60
      },
      "auth.register": {
        "QueueLimit": 0,
        "PermitLimit": 10,
        "WindowSeconds": 60
      },
      "auth.login": {
        "QueueLimit": 0,
        "PermitLimit": 20,
        "WindowSeconds": 60
      },
      "auth.refresh": {
        "QueueLimit": 0,
        "PermitLimit": 30,
        "WindowSeconds": 60
      },
      "auth.logout": {
        "QueueLimit": 0,
        "PermitLimit": 30,
        "WindowSeconds": 60
      },
      "users.get_users": {
        "QueueLimit": 0,
        "PermitLimit": 80,
        "WindowSeconds": 60
      },
      "users.get_current": {
        "QueueLimit": 0,
        "PermitLimit": 120,
        "WindowSeconds": 60
      },
      "users.get_by_id": {
        "QueueLimit": 0,
        "PermitLimit": 120,
        "WindowSeconds": 60
      },
      "users.update_current": {
        "QueueLimit": 0,
        "PermitLimit": 30,
        "WindowSeconds": 60
      },
      "users.update_password": {
        "QueueLimit": 0,
        "PermitLimit": 15,
        "WindowSeconds": 60
      },
      "users.promote": {
        "QueueLimit": 0,
        "PermitLimit": 20,
        "WindowSeconds": 60
      },
      "users.demote": {
        "QueueLimit": 0,
        "PermitLimit": 20,
        "WindowSeconds": 60
      },
      "users.lock": {
        "QueueLimit": 0,
        "PermitLimit": 25,
        "WindowSeconds": 60
      },
      "users.unlock": {
        "QueueLimit": 0,
        "PermitLimit": 25,
        "WindowSeconds": 60
      },
      "sessions.get_current": {
        "QueueLimit": 0,
        "PermitLimit": 120,
        "WindowSeconds": 60
      },
      "sessions.revoke_one": {
        "QueueLimit": 0,
        "PermitLimit": 40,
        "WindowSeconds": 60
      },
      "sessions.revoke_all": {
        "QueueLimit": 0,
        "PermitLimit": 20,
        "WindowSeconds": 60
      }
    }
  },
  "AllowedHosts": "*"
}
